{
  "name": "quotebook",
  "version": "0.1.0",
  "private": true,
  "description": "A procurement agent on Appwrite: state a need, it finds suppliers, emails them for real quotes, reads the replies, and compares them.",
  "scripts": {
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first --network-family-autoselection-attempt-timeout=2000' next dev",
    "build": "next build",
    "start": "NODE_OPTIONS='--dns-result-order=ipv4first --network-family-autoselection-attempt-timeout=2000' next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:setup": "NODE_OPTIONS='--dns-result-order=ipv4first --network-family-autoselection-attempt-timeout=2000' tsx --env-file=.env.local scripts/setup-db.ts",
    "db:clear": "NODE_OPTIONS='--dns-result-order=ipv4first --network-family-autoselection-attempt-timeout=2000' tsx --env-file=.env.local scripts/clear-data.ts",
    "fn:deploy": "NODE_OPTIONS='--dns-result-order=ipv4first --network-family-autoselection-attempt-timeout=2000' tsx --env-file=.env.local scripts/deploy-cron-function.ts"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.10",
    "@base-ui/react": "^1.9.0",
    "@mendable/firecrawl-js": "^4.52.0",
    "@tailwindcss/postcss": "^4.3.4",
    "appwrite": "^29.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "node-appwrite": "^31.1.0",
    "postcss": "^8.5.32",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
